# Copy to .env. Everything works WITHOUT a key (offline agents); a key turns on the LLM agents.

# --- LLM (OpenAI-compatible). Nebius AI Studio is the course default ---
NEBIUS_API_KEY=
FS_LLM_BASE_URL=https://api.studio.nebius.com/v1/
FS_LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Or OpenAI (leave NEBIUS_API_KEY empty and remove FS_LLM_BASE_URL):
# OPENAI_API_KEY=
# FS_LLM_MODEL=gpt-4.1-mini

# Or a LOCAL model with Ollama (Week 5): no data leaves your machine and no per-call fee.
#   ollama pull llama3.1:8b   then:
# OPENAI_API_KEY=ollama
# FS_LLM_BASE_URL=http://localhost:11434/v1
# FS_LLM_MODEL=llama3.1:8b
# LR_PRICE_IN_PER_M=0
# LR_PRICE_OUT_PER_M=0

# --- Observability (Week 4): LangSmith traces every agent, LLM call and tool call ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=laneroom

# --- Cost estimate: USD per 1M tokens for your provider (defaults are placeholders, set real rates) ---
# LR_PRICE_IN_PER_M=0.13
# LR_PRICE_OUT_PER_M=0.40

# --- LaneRoom ---
# LR_AGENT_MODE=auto            # auto | offline
# LR_RESEARCH_VIA_MCP=0         # 1 = Researcher calls the knowledge base through the MCP server
# LR_MAX_VERIFY_RETRIES=2
# LR_CLAIMS_PER_SIDE=5
# LR_CANDIDATES_K=12
# LR_RESEARCH_RETRY_MIN_SCORE=0.5  # Researcher re-searches sub-questions whose best hit scores below this
# Tender allocation rules the Judge applies (percent of the lane's loads)
# LR_MAX_SHARE=60               # no carrier above this
# LR_MIN_SHARE=10               # every qualified carrier keeps at least this as backup capacity
# LR_MIN_ACCEPTANCE=80          # below this tender acceptance on the lane, backup only
# LR_SYNTHETIC_CAP=25           # cap for providers backed only by synthetic / unaudited data (Armada)
